---
// Footer — matching reference.png exactly: Logo | Quick Links | Support | Contact Us | Follow Us (horizontal icons) + Yellow accent line
import { getAssetUrl } from '../utils/cloudinary';

const logoUrl = getAssetUrl('logo');
---

<footer id="contact" class="bg-[#050507] pt-12 sm:pt-18 pb-10 relative overflow-hidden">
  <!-- Ambient bottom glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-24 pointer-events-none" style="background: rgba(204,255,0,0.03); filter: blur(80px);" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Main footer grid: logo | quick links | support | contact | follow us -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-7 sm:gap-8 lg:gap-6 pb-10 sm:pb-12">
      
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1 lg:col-span-1">
        <a href="#home" class="inline-block mb-3 sm:mb-4">
          <img src={logoUrl} alt="Peakform Fitness Club" class="h-8 sm:h-9 w-auto object-contain" />
        </a>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-display italic font-bold text-white uppercase tracking-wider text-xs sm:text-sm mb-3 sm:mb-4">Quick Links</h4>
        <ul class="space-y-2 text-xs sm:text-sm text-gray-400">
          <li><a href="#home" class="hover:text-[#CCFF00] transition-colors duration-200">Home</a></li>
          <li><a href="#programs" class="hover:text-[#CCFF00] transition-colors duration-200">Programs</a></li>
          <li><a href="#trainers" class="hover:text-[#CCFF00] transition-colors duration-200">Trainers</a></li>
          <li><a href="#membership" class="hover:text-[#CCFF00] transition-colors duration-200">Membership</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h4 class="font-display italic font-bold text-white uppercase tracking-wider text-xs sm:text-sm mb-3 sm:mb-4">Support</h4>
        <ul class="space-y-2 text-xs sm:text-sm text-gray-400">
          <li><a href="#about" class="hover:text-[#CCFF00] transition-colors duration-200">About Us</a></li>
          <li><a href="#" class="hover:text-[#CCFF00] transition-colors duration-200">FAQs</a></li>
          <li><a href="#" class="hover:text-[#CCFF00] transition-colors duration-200">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-[#CCFF00] transition-colors duration-200">Terms & Conditions</a></li>
        </ul>
      </div>

      <!-- Contact Us -->
      <div class="col-span-2 sm:col-span-1">
        <h4 class="font-display italic font-bold text-white uppercase tracking-wider text-xs sm:text-sm mb-3 sm:mb-4">Contact Us</h4>
        <div class="space-y-2 text-xs sm:text-sm text-gray-400">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#CCFF00] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>+91 98765 43210</span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#CCFF00] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="break-all">hello@peakform.in</span>
          </div>
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#CCFF00] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Kalyan, Maharashtra, India</span>
          </div>
        </div>
      </div>

      <!-- Follow Us (horizontal icons row) -->
      <div class="col-span-2 sm:col-span-1">
        <h4 class="font-display italic font-bold text-white uppercase tracking-wider text-xs sm:text-sm mb-3 sm:mb-4">Follow Us</h4>
        <div class="flex items-center gap-4 text-white">
          <!-- Instagram -->
          <a href="#" aria-label="Instagram" class="hover:text-[#CCFF00] transition-colors duration-200">
            <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <!-- YouTube -->
          <a href="#" aria-label="YouTube" class="hover:text-[#CCFF00] transition-colors duration-200">
            <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a href="#" aria-label="LinkedIn" class="hover:text-[#CCFF00] transition-colors duration-200">
            <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
              <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <!-- X (Twitter) -->
          <a href="#" aria-label="X" class="hover:text-[#CCFF00] transition-colors duration-200">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Yellow horizontal accent separator line -->
    <div class="h-[2px] bg-[#CCFF00] w-full mb-5 sm:mb-6 opacity-90 shadow-[0_0_12px_rgba(204,255,0,0.5)]"></div>

    <!-- Bottom copyright bar -->
    <div class="text-center text-[11px] sm:text-xs text-gray-400 font-medium">
      © 2026 Peakform Fitness Club. All Rights Reserved.
    </div>
  </div>
</footer>