---
// Feature Bar — floating rounded container matching reference.png exactly
---
<section class="relative z-20 -mt-6 sm:-mt-8 mb-12 sm:mb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl sm:rounded-3xl bg-[#0F0F15] border border-white/10 shadow-[0_15px_40px_rgba(0,0,0,0.6)] overflow-hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-white/[0.08]">
        
        <!-- 1. World-Class Equipment -->
        <div class="flex items-center gap-4 px-6 py-5 group hover:bg-white/[0.02] transition-colors">
          <div class="w-11 h-11 rounded-xl bg-[rgba(204,255,0,0.08)] border border-[rgba(204,255,0,0.25)] flex items-center justify-center text-[#CCFF00] flex-shrink-0 group-hover:bg-[#CCFF00] group-hover:text-black group-hover:shadow-[0_0_15px_rgba(204,255,0,0.5)] transition-all duration-300">
            <!-- Barbell icon -->
            <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 5v14M18 5v14M2 9v6M22 9v6M6 12h12M4 7v10M20 7v10" />
            </svg>
          </div>
          <div>
            <div class="font-display italic font-black text-white text-base tracking-wide uppercase">World-Class Equipment</div>
            <div class="text-[12px] text-gray-400 mt-0.5 font-normal">Train with the best</div>
          </div>
        </div>

        <!-- 2. Expert Trainers -->
        <div class="flex items-center gap-4 px-6 py-5 group hover:bg-white/[0.02] transition-colors">
          <div class="w-11 h-11 rounded-xl bg-[rgba(204,255,0,0.08)] border border-[rgba(204,255,0,0.25)] flex items-center justify-center text-[#CCFF00] flex-shrink-0 group-hover:bg-[#CCFF00] group-hover:text-black group-hover:shadow-[0_0_15px_rgba(204,255,0,0.5)] transition-all duration-300">
            <!-- Trainer Coach Cap Icon -->
            <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4a4 4 0 0 1 4 4c0 .8-.2 1.5-.6 2.1l2.6 1.3-1.3 2.6H7.3l-1.3-2.6 2.6-1.3A3.9 3.9 0 0 1 8 8a4 4 0 0 1 4-4z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" />
            </svg>
          </div>
          <div>
            <div class="font-display italic font-black text-white text-base tracking-wide uppercase">Expert Trainers</div>
            <div class="text-[12px] text-gray-400 mt-0.5 font-normal">Certified & Experienced</div>
          </div>
        </div>

        <!-- 3. Flexible Timings -->
        <div class="flex items-center gap-4 px-6 py-5 group hover:bg-white/[0.02] transition-colors">
          <div class="w-11 h-11 rounded-xl bg-[rgba(204,255,0,0.08)] border border-[rgba(204,255,0,0.25)] flex items-center justify-center text-[#CCFF00] flex-shrink-0 group-hover:bg-[#CCFF00] group-hover:text-black group-hover:shadow-[0_0_15px_rgba(204,255,0,0.5)] transition-all duration-300">
            <!-- Calendar Schedule Icon with dots -->
            <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" stroke-linecap="round" />
              <line x1="8" y1="2" x2="8" y2="6" stroke-linecap="round" />
              <line x1="3" y1="10" x2="21" y2="10" />
              <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" stroke-linecap="round" stroke-width="2.5" />
            </svg>
          </div>
          <div>
            <div class="font-display italic font-black text-white text-base tracking-wide uppercase">Flexible Timings</div>
            <div class="text-[12px] text-gray-400 mt-0.5 font-normal">Train at your convenience</div>
          </div>
        </div>

        <!-- 4. Hygienic & Safe -->
        <div class="flex items-center gap-4 px-6 py-5 group hover:bg-white/[0.02] transition-colors">
          <div class="w-11 h-11 rounded-xl bg-[rgba(204,255,0,0.08)] border border-[rgba(204,255,0,0.25)] flex items-center justify-center text-[#CCFF00] flex-shrink-0 group-hover:bg-[#CCFF00] group-hover:text-black group-hover:shadow-[0_0_15px_rgba(204,255,0,0.5)] transition-all duration-300">
            <!-- Shield Check Icon -->
            <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4" />
            </svg>
          </div>
          <div>
            <div class="font-display italic font-black text-white text-base tracking-wide uppercase">Hygienic & Safe</div>
            <div class="text-[12px] text-gray-400 mt-0.5 font-normal">Clean, secure & well-maintained</div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>