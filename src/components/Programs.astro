---
// Programs section — matching reference.png exactly: Left heading block, Right 4 cards in a row
import { getAssetUrl } from '../utils/cloudinary';

const programs = [
  {
    title: "Strength Training",
    image: getAssetUrl('programStrength'),
    planTarget: "Premium",
  },
  {
    title: "Weight Loss",
    image: getAssetUrl('programWeightloss'),
    planTarget: "Basic",
  },
  {
    title: "Endurance & Conditioning",
    image: getAssetUrl('programEndurance'),
    planTarget: "Premium",
  },
  {
    title: "Mobility & Recovery",
    image: getAssetUrl('programMobility'),
    planTarget: "Elite",
  },
];
---

<section id="programs" class="py-14 sm:py-20 lg:py-24 bg-[#070709] relative overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute top-1/3 left-1/4 -translate-y-1/2 w-96 h-96 rounded-full blur-[140px] pointer-events-none" style="background: rgba(204,255,0,0.03)" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="flex flex-col lg:flex-row gap-8 sm:gap-10 lg:gap-12 items-center">
      
      <!-- LEFT: Section heading block -->
      <div class="lg:w-[280px] flex-shrink-0 w-full text-left">
        <div class="text-[#CCFF00] text-xs font-black uppercase tracking-widest mb-2 sm:mb-3">OUR PROGRAMS</div>
        <h2 class="font-display italic font-black text-white uppercase leading-[0.88] mb-4 sm:mb-5"
          style="font-size: clamp(2.2rem, 6vw, 3.4rem)">
          TRAIN SMARTER,<br/>
          GET STRON<span class="text-[#CCFF00]" style="text-shadow: 0 0 25px rgba(204,255,0,0.4)">GER</span>
        </h2>
        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed mb-5 sm:mb-6">
          Goal-oriented programs for all fitness levels, from building strength to improving overall fitness.
        </p>
        <!-- Neon yellow accent bar -->
        <div class="w-14 h-1.5 rounded-full bg-[#CCFF00] shadow-[0_0_15px_rgba(204,255,0,0.5)]"></div>
      </div>

      <!-- RIGHT: 4 cards matching reference -->
      <div class="flex-1 w-full grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        {programs.map((prog) => (
          <div
            class="group relative overflow-hidden cursor-pointer transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_0_35px_rgba(204,255,0,0.35)] rounded-xl sm:rounded-2xl"
            onclick={`window.dispatchEvent(new CustomEvent('open-join-modal', { detail: { plan: '${prog.planTarget}' } }))`}
          >
            <!-- Raw program card contains the authentic neon border, icon, and title -->
            <img
              src={prog.image}
              alt={prog.title}
              class="w-full h-auto object-contain transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </div>
        ))}
      </div>

    </div>
  </div>
</section>