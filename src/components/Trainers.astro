---
// Trainers — 4 portrait cards matching reference: photo, name below, specialty, neon arrow
import { getAssetUrl } from '../utils/cloudinary';
import TrainerCard from './TrainerCard';

const trainers = [
  {
    name: "Rohan Patil",
    role: "Strength & Conditioning",
    experience: "8+ Years Exp.",
    image: getAssetUrl('trainerRohan'),
    bio: "Specializes in Olympic weightlifting, compound barbell progression, and structural durability for athletes and high performers.",
    specialties: ["Olympic Lifting", "Powerlifting", "Hypertrophy"],
    certifications: ["CSCS Certified Strength Specialist", "CrossFit Level 2 Coach"],
  },
  {
    name: "Aarya Deshmukh",
    role: "Weight Loss Specialist",
    experience: "6+ Years Exp.",
    image: getAssetUrl('trainerAarya'),
    bio: "Expert in metabolic conditioning, sustainable body recomposition, and high-intensity functional training that accelerates fat burn.",
    specialties: ["HIIT & Metabolic", "Fat Loss Protocol", "Body Recomp"],
    certifications: ["ACE Certified Personal Trainer", "Precision Nutrition Level 1"],
  },
  {
    name: "Karan Shetty",
    role: "Muscle Building",
    experience: "9+ Years Exp.",
    image: getAssetUrl('trainerKaran'),
    bio: "Dedicated to biomechanics, muscle hypertrophy, form precision, and injury-free progressive overload protocols.",
    specialties: ["Hypertrophy", "Biomechanics", "Symmetry"],
    certifications: ["ISSA Master Trainer", "Kinesiology Specialist"],
  },
  {
    name: "Nikita More",
    role: "Functional Training",
    experience: "5+ Years Exp.",
    image: getAssetUrl('trainerNikita'),
    bio: "Passionate about dynamic athletic conditioning, multi-directional agility, core stability, and injury prevention.",
    specialties: ["Agility Drills", "Core Stability", "Mobility Rehab"],
    certifications: ["NASM Certified Trainer", "FMS Functional Movement Screen"],
  },
];
---

<section id="trainers" class="py-14 sm:py-20 bg-[#070709] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex items-end justify-between mb-8 sm:mb-10">
      <div>
        <div class="text-[#CCFF00] text-[11px] font-black uppercase tracking-widest mb-1.5 sm:mb-2">OUR TRAINERS</div>
        <h2 class="font-display italic font-black text-white uppercase leading-[0.88]"
          style="font-size: clamp(2.2rem, 5vw, 3.5rem)">
          MEET THE EXPERTS
        </h2>
      </div>
      <button
        onclick="window.dispatchEvent(new CustomEvent('open-join-modal', { detail: { plan: 'Elite' } }))"
        class="flex items-center gap-1.5 sm:gap-2 text-white hover:text-[#CCFF00] text-xs sm:text-sm font-semibold tracking-wide transition-colors cursor-pointer group"
      >
        <span>View All Trainers</span>
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>

    <!-- 4 Trainer Cards — 2x2 grid on mobile, 4 in a row on lg -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {trainers.map((tr) => (
        <TrainerCard client:visible trainer={tr} />
      ))}
    </div>

  </div>
</section>