---
// About Us — matching reference.png exactly: Image+tour | Heading+desc | Checklist | 2x2 Glowing Stats Card
import { getAssetUrl } from '../utils/cloudinary';

const gymInteriorUrl = getAssetUrl('gymInterior');

const checklist = [
  "Certified & Experienced Trainers",
  "Personalized Training Plans",
  "Supportive Fitness Community",
  "Results-Driven Approach",
];
---

<section id="about" class="py-14 sm:py-20 lg:py-24 bg-[#070709] relative overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute bottom-0 right-1/4 w-96 h-96 rounded-full blur-[140px] pointer-events-none" style="background: rgba(204,255,0,0.03)" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 4-column layout on desktop, responsive stack on mobile -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 lg:gap-7 items-center">
      
      <!-- Col 1: Gym Interior Image with Tour CTA (spans 4 cols on desktop) -->
      <div class="lg:col-span-4 relative rounded-2xl sm:rounded-3xl overflow-hidden border border-white/10 group w-full" style="aspect-ratio: 4/3; min-height: 220px;">
        <img
          src={gymInteriorUrl}
          alt="Peakform Gym Interior"
          class="absolute inset-0 w-full h-full object-cover brightness-75 group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 50%, transparent 100%)"/>
        
        <!-- Tour CTA button -->
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-video-modal'))"
          class="absolute bottom-4 left-4 sm:bottom-5 sm:left-5 flex items-center gap-3 cursor-pointer group/btn"
        >
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-2 border-[#CCFF00] bg-black/80 text-[#CCFF00] flex items-center justify-center shadow-[0_0_20px_rgba(204,255,0,0.5)] group-hover/btn:bg-[#CCFF00] group-hover/btn:text-black group-hover/btn:scale-110 transition-all duration-300">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M5 3l14 9-14 9V3z"/></svg>
          </div>
          <span class="text-white text-xs sm:text-sm font-bold leading-tight drop-shadow-md text-left">Take a<br/>Gym Tour</span>
        </button>
      </div>

      <!-- Col 2: Heading & Description (spans 3 cols on desktop) -->
      <div class="lg:col-span-3 flex flex-col justify-center">
        <div class="text-[#CCFF00] text-xs font-black uppercase tracking-widest mb-2 sm:mb-3">ABOUT US</div>
        <h2 class="font-display italic font-black text-white uppercase leading-[0.88] mb-3 sm:mb-4"
          style="font-size: clamp(2.2rem, 5vw, 3.4rem)">
          MORE THAN<br/>
          <span class="text-[#CCFF00]" style="text-shadow: 0 0 25px rgba(204,255,0,0.4)">A GYM</span>
        </h2>
        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed">
          A fitness community focused on real transformation, expert guidance and long-term results.
        </p>
      </div>

      <!-- Col 3: Checklist with vertical divider (spans 2 cols on desktop) -->
      <div class="lg:col-span-2 flex items-center lg:border-l lg:border-white/10 lg:pl-6">
        <div class="space-y-3 sm:space-y-4 w-full">
          {checklist.map((item) => (
            <div class="flex items-start gap-2.5">
              <div class="w-5 h-5 rounded-full bg-[#CCFF00] text-black flex items-center justify-center flex-shrink-0 mt-0.5 shadow-[0_0_10px_rgba(204,255,0,0.4)]">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-gray-200 text-xs sm:text-sm font-medium leading-snug">{item}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Col 4: 2x2 Glowing Stat Grid in ONE unified card (spans 3 cols on desktop) -->
      <div class="lg:col-span-3 rounded-2xl sm:rounded-3xl border-2 border-[#CCFF00] bg-[#0E0E14] shadow-[0_0_35px_rgba(204,255,0,0.22)] p-3 sm:p-5 overflow-hidden w-full">
        <div class="grid grid-cols-2">
          
          <!-- Stat 1: Active Members (top left) -->
          <div class="p-2.5 sm:p-3 text-center border-r border-b border-white/[0.08]">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#CCFF00] mx-auto mb-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <div class="font-display italic font-black text-white text-xl sm:text-3xl leading-none mb-1">
              2.4K+
            </div>
            <div class="text-[10px] sm:text-[11px] text-gray-400 font-medium leading-tight">Active Members</div>
          </div>

          <!-- Stat 2: Weekly Classes (top right) -->
          <div class="p-2.5 sm:p-3 text-center border-b border-white/[0.08]">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#CCFF00] mx-auto mb-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" stroke-linecap="round" />
              <line x1="8" y1="2" x2="8" y2="6" stroke-linecap="round" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <div class="font-display italic font-black text-white text-xl sm:text-3xl leading-none mb-1">
              100+
            </div>
            <div class="text-[10px] sm:text-[11px] text-gray-400 font-medium leading-tight">Weekly Classes</div>
          </div>

          <!-- Stat 3: Expert Coaches (bottom left) -->
          <div class="p-2.5 sm:p-3 text-center border-r border-white/[0.08]">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#CCFF00] mx-auto mb-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="font-display italic font-black text-white text-xl sm:text-3xl leading-none mb-1">
              30+
            </div>
            <div class="text-[10px] sm:text-[11px] text-gray-400 font-medium leading-tight">Expert Coaches</div>
          </div>

          <!-- Stat 4: Years of Excellence (bottom right) -->
          <div class="p-2.5 sm:p-3 text-center">
            <!-- Trophy cup icon matching reference -->
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#CCFF00] mx-auto mb-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M6 4h12a2 2 0 012 2v2a6 6 0 01-6 6h-4a6 6 0 01-6-6V6a2 2 0 012-2z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6H2a2 2 0 00-2 2v1a4 4 0 004 4h2M20 6h2a2 2 0 012 2v1a4 4 0 01-4 4h-2" />
            </svg>
            <div class="font-display italic font-black text-white text-xl sm:text-3xl leading-none mb-1">
              12+
            </div>
            <div class="text-[10px] sm:text-[11px] text-gray-400 font-medium leading-tight">Years of Excellence</div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>